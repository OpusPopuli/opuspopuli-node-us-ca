# =============================================================================
# Region-node `.env` — operator tuning surface (NON-SECRET)
# =============================================================================
#
# docker compose AUTO-LOADS `.env` from this directory for `${VAR:-default}`
# interpolation in docker-compose-prod.yml. This is the single source of truth
# for the handful of knobs an operator tunes per node — set them ONCE here and
# every service resolves the same value, regardless of shell state or which
# subset of containers gets recreated.
#
#   cp .env.example .env      # then edit the values below
#
# `create-op-node bootstrap` GENERATES this file for you (a managed block
# delimited by `# >>> op-node managed >>>` … `# <<< op-node managed <<<`).
# You may add your own lines OUTSIDE that block; a re-bootstrap preserves them.
#
# SECRETS DO NOT GO HERE. Postgres/JWT/HMAC/Supabase credentials live in the
# macOS Keychain (hydrated into compose by `bin/op-compose`) and Supabase
# Vault — never in a plaintext `.env`. For the full list of every variable the
# stack reads (secrets included, for the `--env-file` reference path), see
# environments/.env.production.example. `.env` is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM model (Ollama) — shared by knowledge, region, and the workers
# -----------------------------------------------------------------------------
# The one model every LLM service runs. Ollama runs natively on macOS; the
# model MUST be pulled on the host (`ollama pull <model>`) — `create-op-node`
# bootstrap pulls it and `create-op-node verify` asserts it's present.
#
# Size to the node's unified memory (the LLM shares RAM with ~22 containers +
# Postgres), tiering on total footprint:
#   >= 64 GB  qwen3.6:35b-a3b   (35B MoE, ~3B active — fast on Apple Silicon)
#   32-64 GB  qwen3:14b
#   16-32 GB  qwen2.5:7b
#   <= 16 GB  qwen2.5:3b        (Mac Mini)
# The compose fallback is qwen2.5:3b (smallest, always-pullable) so a bare run
# works anywhere; set your real choice here.
LLM_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# NODE_ENV — production (default) vs development
# -----------------------------------------------------------------------------
# Leave UNSET (defaults to production) for a Tunnel-exposed node. In production
# the backend's CORS validator REQUIRES https:// origins, so a `--local-only`
# node that serves http://localhost origins MUST set development here or
# region + knowledge crash-loop on the CORS preflight. Setting it in `.env`
# (not the shell) makes it durable across recreates.
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Embeddings — ONLY the knowledge service consumes these (RAG)
# -----------------------------------------------------------------------------
# Default provider is `xenova` (in-process, bundled model) — no Ollama pull
# needed. Switch to `ollama` to use the host daemon; the URL default already
# points at the host (containers can't use localhost for the native daemon),
# and the model must be pulled like the LLM. Var names match the backend
# (packages/config-provider/src/configs/embeddings.config.ts).
# EMBEDDINGS_PROVIDER=ollama
# EMBEDDINGS_OLLAMA_URL=http://host.docker.internal:11434
# EMBEDDINGS_OLLAMA_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Other common overrides (uncomment to change)
# -----------------------------------------------------------------------------
# Image tag to run. Defaults to the rolling `latest`; pin a sha-prefixed tag
# for a hot-fix or rollback (e.g. TAG=sha-abc1234).
# TAG=latest

# Comma-separated browser origins allowed by CORS. The default covers the
# local dev ports + your public Supabase URL; set this if you serve a public
# frontend on its own domain. Production origins must be https://.
# ALLOWED_ORIGINS=https://app.yournode.example

# WebAuthn (passkeys). Default `localhost` works for --local-only (browsers
# treat http://localhost as a secure context). Serving a real domain? Set BOTH
# to your values.
#
# Use the REGISTRABLE domain for the RP ID, not the app subdomain. A credential
# registered against yournode.example works from every subdomain; one bound to
# app.yournode.example does not -- and narrowing it later invalidates every
# passkey already registered.
# WEBAUTHN_RP_ID=yournode.example
# WEBAUTHN_ORIGIN=https://app.yournode.example

# -----------------------------------------------------------------------------
# Public auth URLs — REQUIRED once you serve a real domain
# -----------------------------------------------------------------------------
# Skip these and the node still boots healthy, every probe passes, and every
# emailed login link is dead. There is no startup check for this today; it is
# discovered by a user clicking a link. See opuspopuli-node#51.
#
# SITE_URL is where GoTrue sends people after they click a magic link, and it
# is the default `redirect_to` stamped into the email itself. LEFT UNSET IT
# FALLS BACK TO http://localhost:3000 -- not a placeholder, the literal value
# that ships in the mail.
# SITE_URL=https://app.yournode.example

# Redirect allow-list. Anything the app passes as `redirect_to` must match an
# entry here or GoTrue SILENTLY DISCARDS it and substitutes SITE_URL -- no
# error, no log line. So a correct app sending a correct redirect still lands
# on the wrong page if this is empty. `/**` is a path wildcard.
#
# Keep a localhost entry to run a local frontend against this node. It is an
# allow-list entry, not a default, so it cannot leak into emails.
# ADDITIONAL_REDIRECT_URLS=https://app.yournode.example/**,http://localhost:3200/**

# The PUBLIC base URL of this node's Supabase, used to build the link host in
# auth emails (API_EXTERNAL_URL) and as the JWT issuer. It must be reachable
# from a phone on cellular data -- an internal Docker or Tailscale hostname
# produces links that resolve for nobody.
#
# Requires a Cloudflare Tunnel public hostname pointing at Kong:
#   auth-<region>.<domain>  ->  http://opuspopuli-supabase-kong:8000
#
# CAVEAT: this same variable is also the URL backend services use to CALL
# Supabase, so setting it public makes those calls hairpin out through
# Cloudflare and back -- adding latency and making internal auth depend on the
# tunnel. Accepted trade-off for now; the split is OpusPopuli/opuspopuli#1005.
#
# Changing this changes the JWT issuer and invalidates existing sessions.
# SUPABASE_URL=https://auth.yournode.example

# -----------------------------------------------------------------------------
# Cookie scope — REQUIRED when the app and API are on different subdomains
# -----------------------------------------------------------------------------
# Unset, auth cookies are host-only: the API subdomain sets them and the app
# subdomain cannot read them, so login appears to succeed and the session
# silently does not stick. Set BOTH -- session cookies read COOKIE_DOMAIN, the
# CSRF double-submit token reads CSRF_COOKIE_DOMAIN, and setting only one
# produces a login loop that looks like a backend fault.
#
# Use the leading-dot registrable domain so every subdomain shares them.
# COOKIE_DOMAIN=.yournode.example
# CSRF_COOKIE_DOMAIN=.yournode.example

# SameSite policy. Leave unset unless the app and API are on DIFFERENT
# registrable domains, which requires `none` (and therefore Secure/HTTPS).
# Same-domain subdomains are already same-site and need nothing here.
# COOKIE_SAME_SITE=none

# -----------------------------------------------------------------------------
# Region sync — scheduler + bill-enrichment tuning
# -----------------------------------------------------------------------------
# Nightly region-sync crons (~2 AM, per data type). Set false to disable ALL
# scheduled syncs — e.g. while validating data or holding for a fix. Manual
# syncRegionData mutations still work. Default (unset) = enabled.
# REGION_SYNC_CRON_ENABLED=false
#
# Bill enrichment (Phase 6 "summarize") throughput. Concurrency runs N bills'
# LLM calls in parallel and REQUIRES OLLAMA_NUM_PARALLEL >= this on the native
# Ollama service (`launchctl setenv OLLAMA_NUM_PARALLEL N` + restart Ollama),
# or parallel calls just queue. Default 1 = serial.
# BILL_ENRICHMENT_CONCURRENCY=4
#
# Per-bill LLM request timeout (ms) during enrichment; raise for large bills on
# slow models. Default 120000 (2 min).
# BILL_ENRICHMENT_REQUEST_TIMEOUT_MS=120000
#
# Bill VOTES extraction (Phase 3 votes_only). Concurrency runs N bills' vote
# extractions in parallel — same OLLAMA_NUM_PARALLEL requirement as enrichment
# (#892). Default 1 = serial.
# BILL_VOTES_CONCURRENCY=4
#
# Max output tokens for votes extraction; default 8000 (#894, up from 4000).
# Large roll-calls truncate below this and fail to parse — raise if big-vote
# bills still show extraction failures.
# BILL_VOTES_MAX_TOKENS=8000
