#!/bin/bash
# op-deploy — pull, recreate, and reclaim disk, retaining one rollback generation.
#
# Why this exists: on 2026-08-12 the Docker VM disk hit 100% mid-deploy and
# Postgres began crash-looping with `could not write lock file
# "postmaster.pid": No space left on device`, taking production down and
# killing a 4-hour campaign-finance re-sync. The prune that recovered it
# reclaimed 263 GB across 131 dangling images.
#
# Nothing had ever removed them. Every deploy pulls a new `:latest`, which
# untags the previous image and leaves it dangling; with no cleanup step those
# orphans accumulate one full image set per release until the disk fills. The
# host disk is irrelevant here and reading it will mislead you — it had 463 GB
# free at the time. The constraint is Docker Desktop's VM disk (322 GB).
#
# Retention: exactly one previous generation, via tagging rather than a custom
# reaper. `docker image prune` removes only DANGLING (untagged) images, so
# tagging the current image `:previous` before pulling is what protects it. On
# the next deploy that tag moves forward, orphaning the generation behind it,
# which the prune then reclaims. Self-limiting, and it uses Docker's own
# semantics instead of fighting them.
#
# Rollback:
#   docker tag ghcr.io/opuspopuli/<svc>:previous ghcr.io/opuspopuli/<svc>:latest
#   ./bin/op-compose -f docker-compose-prod.yml up -d <svc>
#
# This is a SEPARATE script rather than an edit to op-compose, for two reasons:
# op-compose is auto-generated by `create-op-node bootstrap` and carries a
# do-not-edit banner, and it ends in `exec docker compose "$@"`, so nothing
# placed after that line would ever run.
#
# Usage:
#   ./bin/op-deploy                          # docker-compose-prod.yml
#   ./bin/op-deploy docker-compose-uat.yml   # explicit compose file

set -euo pipefail

cd "$(dirname "$0")/.."

COMPOSE_FILE="${1:-docker-compose-prod.yml}"
OC="./bin/op-compose -f ${COMPOSE_FILE}"

if [ ! -f "$COMPOSE_FILE" ]; then
  echo "op-deploy: compose file '$COMPOSE_FILE' not found" >&2
  exit 1
fi

# Docker's VM disk, not the host's. `df` on the Mac reports 400+ GB free while
# the VM disk is at 100% — that discrepancy is what hid this failure until
# Postgres fell over.
#
# Read via `exec` into a container that is already running rather than
# `docker run`: pulling an image to measure free space is a poor idea when the
# thing being measured is free space, and it would fail outright at 100% full.
# Any container's overlay root reports the VM filesystem.
disk_usage() {
  local c
  c=$(docker ps --format '{{.Names}}' | head -1)
  if [ -z "$c" ]; then
    echo "  (no running container to measure from)"
    return 0
  fi
  docker exec "$c" df -h / 2>/dev/null | tail -1 \
    || echo "  (could not read docker VM disk)"
}

echo "==> Docker VM disk before:"
disk_usage

# ── 1. Mark the current generation as the rollback point ────────────────────
# Done BEFORE the pull, while `:latest` still refers to what is running.
# Untagged images are what prune reclaims, so this tag IS the retention.
#
# The repo list is scraped from the compose file rather than taken from
# `op-compose config --images`, deliberately: op-compose reads every secret
# from the login Keychain, which SSH sessions do not auto-unlock, so it exits 1
# over SSH until the operator runs `security unlock-keychain`. Tagging needs no
# secrets, and it should not be the step that fails. Only the pull and up below
# genuinely require an unlocked Keychain.
#
# Compose declares these as `ghcr.io/opuspopuli/<svc>:${TAG:-latest}`; we
# resolve TAG with the same default so both agree on what is current.
TAG="${TAG:-latest}"

echo ""
echo "==> Tagging current images as :previous (rollback point)"
grep -oE 'ghcr\.io/opuspopuli/[a-z0-9-]+' "$COMPOSE_FILE" | sort -u | while read -r repo; do
  # Only tag what is actually held locally. A service present in the compose
  # file but never pulled has no image to protect, and `docker tag` failing
  # would abort the whole deploy under `set -e`.
  if docker image inspect "${repo}:${TAG}" >/dev/null 2>&1; then
    docker tag "${repo}:${TAG}" "${repo}:previous"
    echo "    ${repo}:previous"
  fi
done

# ── 2. Pull + recreate ──────────────────────────────────────────────────────
echo ""
echo "==> Pulling"
$OC pull

echo ""
echo "==> Recreating containers"
$OC up -d

# ── 3. Reclaim ──────────────────────────────────────────────────────────────
# Dangling only. Images still carrying `:latest` or `:previous` are untouched,
# so this removes the generation two releases back and nothing newer.
#
# Deliberately NOT `prune -a`: that would delete any tagged image without a
# running container, which includes `:previous` — destroying the rollback this
# script exists to preserve.
echo ""
echo "==> Reclaiming dangling images"
docker image prune -f

echo ""
echo "==> Docker VM disk after:"
disk_usage
